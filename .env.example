# ==============================================================================
# VELA MEDIA INTELLIGENCE PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# Do NOT commit sensitive keys to source control. Copy to .env for local usage.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# Backend API Endpoints
BACKEND_BASE_URL=https://api.vela.app
WEBSOCKET_REALTIME_URL=wss://api.vela.app/api/v1/realtime

# Authentication & JWT Secrets (Backend Only)
JWT_SECRET_KEY=CHANGE_THIS_SECRET_IN_PRODUCTION_TO_A_HIGH_ENTROPY_STRING
JWT_ALGORITHM=HS256

# Database & Cache (Backend Only)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vela_user
POSTGRES_PASSWORD=vela_password
POSTGRES_DB=vela_db
REDIS_URL=redis://localhost:6379/0

# Object Storage S3 / MinIO (Backend Only)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=vela-media-assets
S3_REGION=us-east-1

# External AI Provider Keys (Managed by Backend Gateway Only — Never in Mobile App)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPL_API_KEY=

# Store In-App Billing Credentials (Backend Server Validation Only)
PLAY_SERVICE_ACCOUNT_JSON=
APPLE_API_KEY_ID=
APPLE_API_ISSUER_ID=
APPLE_API_PRIVATE_KEY=
